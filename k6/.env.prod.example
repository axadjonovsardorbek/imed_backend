# Production k6 test — bu faylni git ga commit QILMANG (tokenlar bilan).
# cp k6/.env.prod.example k6/.env.prod && nano k6/.env.prod

ALLOW_PROD=1
BASE_URL=https://prod.imedteam.uz

# Prod da faqat tayyor token (login endpointini stress qilmang)
ACCESS_TOKEN=

# Test user (haqiqiy prod user, lekin faol emas / test akkaunt)
# USER_PHONE=
# USER_PASSWORD=

COURSE_ID=
LESSON_ID=
LANG=uz

# prod-load.js uchun max parallel user (default 15, oshirmang 30 dan)
PROD_MAX_VUS=15
